[
  {
    "index": "1",
    "time": "00:00:00,100 --> 00:00:00,766",
    "text": "来了来了"
  },
  {
    "index": "2",
    "time": "00:00:00,766 --> 00:00:03,400",
    "text": "黑棋一户的半牛头蓄化形态终于了"
  },
  {
    "index": "3",
    "time": "00:00:03,400 --> 00:00:04,666",
    "text": "真世界城最顶层"
  },
  {
    "index": "4",
    "time": "00:00:04,666 --> 00:00:06,033",
    "text": "一户推开宫殿大门"
  },
  {
    "index": "5",
    "time": "00:00:06,033 --> 00:00:08,200",
    "text": "前方端坐于王座之上的巍峨身影"
  },
  {
    "index": "6",
    "time": "00:00:08,200 --> 00:00:09,300",
    "text": "正是有哈巴赫"
  },
  {
    "index": "7",
    "time": "00:00:09,366 --> 00:00:10,566",
    "text": "随着一户朝鲜走去"
  },
  {
    "index": "8",
    "time": "00:00:10,566 --> 00:00:12,166",
    "text": "其身上那不断高涨的0压"
  },
  {
    "index": "9",
    "time": "00:00:12,166 --> 00:00:13,666",
    "text": "几乎快要浓郁到尸体化"
  },
  {
    "index": "10",
    "time": "00:00:13,666 --> 00:00:15,800",
    "text": "这一战不仅是为了守护整个世界"
  },
  {
    "index": "11",
    "time": "00:00:15,800 --> 00:00:16,800",
    "text": "更是为了复仇"
  },
  {
    "index": "12",
    "time": "00:00:16,800 --> 00:00:17,766",
    "text": "从父亲口中"
  },
  {
    "index": "13",
    "time": "00:00:17,766 --> 00:00:19,466",
    "text": "他得知母亲当年的真正死因"
  },
  {
    "index": "14",
    "time": "00:00:19,466 --> 00:00:20,700",
    "text": "根本不是因为那只虚"
  },
  {
    "index": "15",
    "time": "00:00:20,700 --> 00:00:21,566",
    "text": "而是因为当时"
  },
  {
    "index": "16",
    "time": "00:00:21,566 --> 00:00:22,866",
    "text": "被有哈巴赫发动的圣蝶"
  },
  {
    "index": "17",
    "time": "00:00:22,866 --> 00:00:24,266",
    "text": "强行夺走了所有力量"
  },
  {
    "index": "18",
    "time": "00:00:24,266 --> 00:00:25,400",
    "text": "所以才会被杀"
  },
  {
    "index": "19",
    "time": "00:00:25,400 --> 00:00:27,400",
    "text": "亲近愤怒一护一刀推出去"
  },
  {
    "index": "20",
    "time": "00:00:27,400 --> 00:00:28,533",
    "text": "死外有哈巴赫"
  },
  {
    "index": "21",
    "time": "00:00:28,533 --> 00:00:30,866",
    "text": "恐怖的刀芒斩下却无法伤其分毫"
  },
  {
    "index": "22",
    "time": "00:00:30,866 --> 00:00:32,366",
    "text": "吞噬了灵王的有哈巴赫"
  },
  {
    "index": "23",
    "time": "00:00:32,366 --> 00:00:34,500",
    "text": "如今即便暂时失去权之权灵"
  },
  {
    "index": "24",
    "time": "00:00:34,500 --> 00:00:35,833",
    "text": "也不是一户可以对付"
  },
  {
    "index": "25",
    "time": "00:00:35,933 --> 00:00:37,700",
    "text": "漆黑灵压爆射一旁的只鸡"
  },
  {
    "index": "26",
    "time": "00:00:37,700 --> 00:00:39,400",
    "text": "立刻推动三天杰顿阻挡"
  },
  {
    "index": "27",
    "time": "00:00:39,400 --> 00:00:41,066",
    "text": "虽然仅在一瞬间便破损"
  },
  {
    "index": "28",
    "time": "00:00:41,066 --> 00:00:43,400",
    "text": "但也足够一户缓下一口气调整身形"
  },
  {
    "index": "29",
    "time": "00:00:43,400 --> 00:00:44,866",
    "text": "有着只鸡力量的加持"
  },
  {
    "index": "30",
    "time": "00:00:44,866 --> 00:00:46,766",
    "text": "一护再次冲到有哈巴赫面前"
  },
  {
    "index": "31",
    "time": "00:00:46,766 --> 00:00:47,933",
    "text": "对于一护的悲伤"
  },
  {
    "index": "32",
    "time": "00:00:47,933 --> 00:00:49,166",
    "text": "有哈没有丝毫愧疚"
  },
  {
    "index": "33",
    "time": "00:00:49,166 --> 00:00:49,766",
    "text": "在他看来"
  },
  {
    "index": "34",
    "time": "00:00:49,766 --> 00:00:51,800",
    "text": "黑棋真校只是遵循命运死去"
  },
  {
    "index": "35",
    "time": "00:00:51,800 --> 00:00:53,800",
    "text": "他生下一伙并成为自己的养分"
  },
  {
    "index": "36",
    "time": "00:00:53,800 --> 00:00:55,500",
    "text": "难道还有比这更幸福的事吗"
  },
  {
    "index": "37",
    "time": "00:00:55,500 --> 00:00:57,166",
    "text": "而正是这种理所应当的傲慢"
  },
  {
    "index": "38",
    "time": "00:00:57,166 --> 00:00:58,200",
    "text": "让渔夫更加愤怒"
  },
  {
    "index": "39",
    "time": "00:00:58,200 --> 00:00:59,266",
    "text": "被击飞过后"
  },
  {
    "index": "40",
    "time": "00:00:59,266 --> 00:01:00,300",
    "text": "他再度冲了上去"
  },
  {
    "index": "41",
    "time": "00:01:00,300 --> 00:01:01,600",
    "text": "如此鲁莽的突击"
  },
  {
    "index": "42",
    "time": "00:01:01,600 --> 00:01:02,266",
    "text": "现在的一护"
  },
  {
    "index": "43",
    "time": "00:01:02,266 --> 00:01:04,200",
    "text": "仿佛像是被仇恨冲昏的头脑"
  },
  {
    "index": "44",
    "time": "00:01:04,200 --> 00:01:06,000",
    "text": "漆黑的伶鸦浪潮碾压二人"
  },
  {
    "index": "45",
    "time": "00:01:06,000 --> 00:01:08,000",
    "text": "只鸡见状立刻将其倒下"
  },
  {
    "index": "46",
    "time": "00:01:08,000 --> 00:01:09,400",
    "text": "吃鸡的拒绝无法挡住"
  },
  {
    "index": "47",
    "time": "00:01:09,400 --> 00:01:10,500",
    "text": "从本质上来说"
  },
  {
    "index": "48",
    "time": "00:01:10,500 --> 00:01:11,366",
    "text": "有哈的力量中"
  },
  {
    "index": "49",
    "time": "00:01:11,366 --> 00:01:13,000",
    "text": "流淌着和一户相同的东西"
  },
  {
    "index": "50",
    "time": "00:01:13,000 --> 00:01:14,800",
    "text": "吃鸡会在无意识中接受他"
  },
  {
    "index": "51",
    "time": "00:01:14,800 --> 00:01:16,566",
    "text": "就在黑雾即将吞噬之机时"
  },
  {
    "index": "52",
    "time": "00:01:16,566 --> 00:01:17,700",
    "text": "一户赶紧将其推"
  },
  {
    "index": "53",
    "time": "00:01:17,700 --> 00:01:19,333",
    "text": "走自己承受了这一切之机"
  },
  {
    "index": "54",
    "time": "00:01:19,333 --> 00:01:20,933",
    "text": "艰难爬起想要发动防御"
  },
  {
    "index": "55",
    "time": "00:01:20,933 --> 00:01:21,500",
    "text": "可下一刻"
  },
  {
    "index": "56",
    "time": "00:01:21,500 --> 00:01:23,066",
    "text": "他就被恐怖的灵压压了下去"
  },
  {
    "index": "57",
    "time": "00:01:23,066 --> 00:01:24,200",
    "text": "不能在这里倒下"
  },
  {
    "index": "58",
    "time": "00:01:24,200 --> 00:01:25,400",
    "text": "之机再也不想看到一户"
  },
  {
    "index": "59",
    "time": "00:01:25,400 --> 00:01:27,000",
    "text": "为了保护自己变成那种模样"
  },
  {
    "index": "60",
    "time": "00:01:27,000 --> 00:01:28,200",
    "text": "他已经做的够多了"
  },
  {
    "index": "61",
    "time": "00:01:28,200 --> 00:01:30,633",
    "text": "所以这一次就由自己来保护他"
  },
  {
    "index": "62",
    "time": "00:01:30,633 --> 00:01:32,533",
    "text": "趁着只鸡给自己争取来的时间"
  },
  {
    "index": "63",
    "time": "00:01:32,533 --> 00:01:33,533",
    "text": "一户立即起身"
  },
  {
    "index": "64",
    "time": "00:01:33,533 --> 00:01:35,633",
    "text": "朝着有哈绘出最强的月牙十字虫"
  },
  {
    "index": "65",
    "time": "00:01:35,633 --> 00:01:36,966",
    "text": "不过这一击依旧没用"
  },
  {
    "index": "66",
    "time": "00:01:36,966 --> 00:01:39,233",
    "text": "巨大的金色十字被黑色帷幕倒下"
  },
  {
    "index": "67",
    "time": "00:01:39,233 --> 00:01:39,900",
    "text": "有哈明白"
  },
  {
    "index": "68",
    "time": "00:01:39,900 --> 00:01:41,833",
    "text": "即便现在的自己已经等红于世界"
  },
  {
    "index": "69",
    "time": "00:01:41,833 --> 00:01:42,300",
    "text": "可一护"
  },
  {
    "index": "70",
    "time": "00:01:42,300 --> 00:01:44,300",
    "text": "还是毫不犹豫的想要将自己打败"
  },
  {
    "index": "71",
    "time": "00:01:44,300 --> 00:01:45,133",
    "text": "这是因为本狼"
  },
  {
    "index": "72",
    "time": "00:01:45,133 --> 00:01:46,433",
    "text": "所以有哈直接告诉一户"
  },
  {
    "index": "73",
    "time": "00:01:46,433 --> 00:01:47,766",
    "text": "他被兵主部一兵未平"
  },
  {
    "index": "74",
    "time": "00:01:47,766 --> 00:01:49,233",
    "text": "为何一户身披黑色"
  },
  {
    "index": "75",
    "time": "00:01:49,233 --> 00:01:50,600",
    "text": "黑色为混沌之色"
  },
  {
    "index": "76",
    "time": "00:01:50,600 --> 00:01:51,933",
    "text": "混沌又是灵王之力"
  },
  {
    "index": "77",
    "time": "00:01:51,933 --> 00:01:53,400",
    "text": "而能操纵这黑色之人"
  },
  {
    "index": "78",
    "time": "00:01:53,400 --> 00:01:55,300",
    "text": "正是兵主部一兵位那个男人"
  },
  {
    "index": "79",
    "time": "00:01:55,300 --> 00:01:56,966",
    "text": "赋予一户灵王的记忆与解释"
  },
  {
    "index": "80",
    "time": "00:01:56,966 --> 00:01:57,900",
    "text": "只是为了判断"
  },
  {
    "index": "81",
    "time": "00:01:57,900 --> 00:01:59,766",
    "text": "其是否有资格成为承受那股"
  },
  {
    "index": "82",
    "time": "00:01:59,766 --> 00:02:00,933",
    "text": "庞大力量的勇气"
  },
  {
    "index": "83",
    "time": "00:02:00,933 --> 00:02:02,333",
    "text": "所谓的让一护去保护灵王"
  },
  {
    "index": "84",
    "time": "00:02:02,333 --> 00:02:03,333",
    "text": "根本就是在放屁"
  },
  {
    "index": "85",
    "time": "00:02:03,333 --> 00:02:04,933",
    "text": "兵主部一兵卫的真正目的"
  },
  {
    "index": "86",
    "time": "00:02:04,933 --> 00:02:06,366",
    "text": "是让他成为下一任灵王"
  },
  {
    "index": "87",
    "time": "00:02:06,366 --> 00:02:08,633",
    "text": "从而将其塑造成为系三界的傀儡"
  },
  {
    "index": "88",
    "time": "00:02:08,633 --> 00:02:10,333",
    "text": "得知真相的知己震惊不已"
  },
  {
    "index": "89",
    "time": "00:02:10,333 --> 00:02:11,966",
    "text": "但一护的面色却没有变化"
  },
  {
    "index": "90",
    "time": "00:02:11,966 --> 00:02:12,800",
    "text": "那又怎么样"
  },
  {
    "index": "91",
    "time": "00:02:12,800 --> 00:02:14,533",
    "text": "自己会不会成为灵王没有关系"
  },
  {
    "index": "92",
    "time": "00:02:14,533 --> 00:02:16,566",
    "text": "但现在要是不将眼前这个男人打倒"
  },
  {
    "index": "93",
    "time": "00:02:16,566 --> 00:02:18,166",
    "text": "那么自己现实里的所有朋友"
  },
  {
    "index": "94",
    "time": "00:02:18,166 --> 00:02:19,266",
    "text": "亲人都会死"
  },
  {
    "index": "95",
    "time": "00:02:19,266 --> 00:02:21,600",
    "text": "一护挥舞着双刀冲到有哈巴赫眼前"
  },
  {
    "index": "96",
    "time": "00:02:21,600 --> 00:02:23,200",
    "text": "可即便他身影快如鬼魅"
  },
  {
    "index": "97",
    "time": "00:02:23,200 --> 00:02:25,300",
    "text": "对方那密不透风的防御却始终让他"
  },
  {
    "index": "98",
    "time": "00:02:25,300 --> 00:02:26,733",
    "text": "找不到丝毫攻击的计划"
  },
  {
    "index": "99",
    "time": "00:02:26,733 --> 00:02:29,233",
    "text": "一护催动自身灵压不断加快速度"
  },
  {
    "index": "100",
    "time": "00:02:29,233 --> 00:02:29,933",
    "text": "另一边的之际"
  },
  {
    "index": "101",
    "time": "00:02:29,933 --> 00:02:31,400",
    "text": "因为完全看不清他的动作"
  },
  {
    "index": "102",
    "time": "00:02:31,400 --> 00:02:32,700",
    "text": "也没法再继续截动"
  },
  {
    "index": "103",
    "time": "00:02:32,900 --> 00:02:33,633",
    "text": "有哈的周身"
  },
  {
    "index": "104",
    "time": "00:02:33,633 --> 00:02:35,333",
    "text": "凝聚出无数黑色林子肥肉"
  },
  {
    "index": "105",
    "time": "00:02:35,333 --> 00:02:36,900",
    "text": "紧接着全部摄像前方"
  },
  {
    "index": "106",
    "time": "00:02:36,900 --> 00:02:38,500",
    "text": "一户挥舞斩岳不断阻挡"
  },
  {
    "index": "107",
    "time": "00:02:38,500 --> 00:02:40,100",
    "text": "可林子胡刃实在太多"
  },
  {
    "index": "108",
    "time": "00:02:40,100 --> 00:02:41,466",
    "text": "他最终还是被逼腿"
  },
  {
    "index": "109",
    "time": "00:02:41,466 --> 00:02:43,300",
    "text": "就在一户再一次冲过去时"
  },
  {
    "index": "110",
    "time": "00:02:43,300 --> 00:02:45,033",
    "text": "只鸡拉住一脚想让他冷静一点"
  },
  {
    "index": "111",
    "time": "00:02:45,033 --> 00:02:46,100",
    "text": "可就在对上那双"
  },
  {
    "index": "112",
    "time": "00:02:46,100 --> 00:02:47,500",
    "text": "平静到极致的双眼时"
  },
  {
    "index": "113",
    "time": "00:02:47,500 --> 00:02:48,633",
    "text": "他不由松开了手"
  },
  {
    "index": "114",
    "time": "00:02:48,633 --> 00:02:49,500",
    "text": "有哈不解"
  },
  {
    "index": "115",
    "time": "00:02:49,500 --> 00:02:51,200",
    "text": "一护为何一直像是找死般"
  },
  {
    "index": "116",
    "time": "00:02:51,200 --> 00:02:52,400",
    "text": "朝着自己无脑攻击"
  },
  {
    "index": "117",
    "time": "00:02:52,400 --> 00:02:53,466",
    "text": "没人发现的是"
  },
  {
    "index": "118",
    "time": "00:02:53,466 --> 00:02:55,266",
    "text": "经过这一段时间的疯狂碰撞"
  },
  {
    "index": "119",
    "time": "00:02:55,266 --> 00:02:56,300",
    "text": "那柄漆黑的斩破刀"
  },
  {
    "index": "120",
    "time": "00:02:56,300 --> 00:02:57,633",
    "text": "刀间正在慢慢变白"
  },
  {
    "index": "121",
    "time": "00:02:57,633 --> 00:02:59,400",
    "text": "而现在一护的目的达到"
  },
  {
    "index": "122",
    "time": "00:02:59,400 --> 00:03:01,666",
    "text": "通过将灭鹊师的灵压不断灌住井刀"
  },
  {
    "index": "123",
    "time": "00:03:01,666 --> 00:03:02,033",
    "text": "身"
  },
  {
    "index": "124",
    "time": "00:03:02,033 --> 00:03:04,166",
    "text": "他终于把沉睡在里面的续班唤醒"
  },
  {
    "index": "125",
    "time": "00:03:04,166 --> 00:03:06,066",
    "text": "好了以上便是本集的所有内容"
  },
  {
    "index": "126",
    "time": "00:03:06,100 --> 00:03:08,033",
    "text": "相比于正片TV中的普通万劫"
  },
  {
    "index": "127",
    "time": "00:03:08,033 --> 00:03:10,833",
    "text": "假面形态王旭牛头和吴越形态一户"
  },
  {
    "index": "128",
    "time": "00:03:10,833 --> 00:03:12,700",
    "text": "在千年血战篇里的半牛头绪化"
  },
  {
    "index": "129",
    "time": "00:03:12,700 --> 00:03:13,900",
    "text": "大家更喜欢哪一个"
  },
  {
    "index": "130",
    "time": "00:03:13,900 --> 00:03:16,166",
    "text": "经过灵王宫两枚乌王月重铸斩破刀"
  },
  {
    "index": "131",
    "time": "00:03:16,166 --> 00:03:17,833",
    "text": "加五大零番队全员袭"
  },
  {
    "index": "132",
    "time": "00:03:17,833 --> 00:03:20,033",
    "text": "一护彻底解决自身力量护斥问题"
  },
  {
    "index": "133",
    "time": "00:03:20,033 --> 00:03:22,533",
    "text": "死神虚灭却是血脉不在内耗"
  },
  {
    "index": "134",
    "time": "00:03:22,533 --> 00:03:24,733",
    "text": "近战爆发远程零压冲击再生"
  },
  {
    "index": "135",
    "time": "00:03:24,733 --> 00:03:26,366",
    "text": "抗性全部达到个人巅峰"
  },
  {
    "index": "136",
    "time": "00:03:26,366 --> 00:03:28,733",
    "text": "漫画紧急比带过与有哈的初次交手"
  },
  {
    "index": "137",
    "time": "00:03:28,733 --> 00:03:30,633",
    "text": "动漫补充大量拼刀细节"
  },
  {
    "index": "138",
    "time": "00:03:30,633 --> 00:03:32,833",
    "text": "刻意突出此时一护的正面硬实力"
  },
  {
    "index": "139",
    "time": "00:03:32,833 --> 00:03:33,533",
    "text": "分镜凌厉"
  },
  {
    "index": "140",
    "time": "00:03:33,533 --> 00:03:35,433",
    "text": "林王公宏大场景渲染到位"
  },
  {
    "index": "141",
    "time": "00:03:35,433 --> 00:03:36,100",
    "text": "冲击波"
  },
  {
    "index": "142",
    "time": "00:03:36,100 --> 00:03:38,266",
    "text": "双刀斩击的动态表现力远超静态"
  },
  {
    "index": "143",
    "time": "00:03:38,266 --> 00:03:39,966",
    "text": "漫画经费特效这方面"
  },
  {
    "index": "144",
    "time": "00:03:39,966 --> 00:03:41,866",
    "text": "集英社这里确实是舍不下血"
  },
  {
    "index": "145",
    "time": "00:03:41,866 --> 00:03:42,700",
    "text": "那么在这之后"
  },
  {
    "index": "146",
    "time": "00:03:42,700 --> 00:03:43,966",
    "text": "千年血战篇最终季"
  },
  {
    "index": "147",
    "time": "00:03:43,966 --> 00:03:44,933",
    "text": "又会带来怎样的视"
  },
  {
    "index": "148",
    "time": "00:03:44,933 --> 00:03:46,866",
    "text": "觉盛宴就让我们拭目以待吧"
  }
]