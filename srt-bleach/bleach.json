[
  {
    "index": "1",
    "time": "00:00:00,000 --> 00:00:00,766",
    "text": "来了来了"
  },
  {
    "index": "2",
    "time": "00:00:00,766 --> 00:00:01,633",
    "text": "时隔两年"
  },
  {
    "index": "3",
    "time": "00:00:01,633 --> 00:00:04,133",
    "text": "死神千年血战篇最终季终于到来"
  },
  {
    "index": "4",
    "time": "00:00:04,133 --> 00:00:04,400",
    "text": "黑"
  },
  {
    "index": "5",
    "time": "00:00:04,400 --> 00:00:06,600",
    "text": "棋一户和有哈巴赫的决战即将开启"
  },
  {
    "index": "6",
    "time": "00:00:06,600 --> 00:00:08,600",
    "text": "顺龙黑猫战机形态登场"
  },
  {
    "index": "7",
    "time": "00:00:08,600 --> 00:00:10,400",
    "text": "本机第一战正式开始"
  },
  {
    "index": "8",
    "time": "00:00:10,400 --> 00:00:11,666",
    "text": "还是一样的经费爆炸"
  },
  {
    "index": "9",
    "time": "00:00:11,666 --> 00:00:12,333",
    "text": "看吉英社"
  },
  {
    "index": "10",
    "time": "00:00:12,333 --> 00:00:12,733",
    "text": "接下来"
  },
  {
    "index": "11",
    "time": "00:00:12,733 --> 00:00:14,333",
    "text": "又将会给我们带来怎么样的视觉"
  },
  {
    "index": "12",
    "time": "00:00:14,333 --> 00:00:16,300",
    "text": "胜利随着将灵王彻底吞噬"
  },
  {
    "index": "13",
    "time": "00:00:16,300 --> 00:00:18,133",
    "text": "由哈巴赫完成最后的进化"
  },
  {
    "index": "14",
    "time": "00:00:18,133 --> 00:00:20,200",
    "text": "林王公如今竟归其一人之手"
  },
  {
    "index": "15",
    "time": "00:00:20,200 --> 00:00:22,266",
    "text": "而整个世界也即将彻底毁灭"
  },
  {
    "index": "16",
    "time": "00:00:22,266 --> 00:00:24,566",
    "text": "同一事件一户从石田那里得知"
  },
  {
    "index": "17",
    "time": "00:00:24,566 --> 00:00:25,766",
    "text": "他之所以选择叛变"
  },
  {
    "index": "18",
    "time": "00:00:25,766 --> 00:00:27,066",
    "text": "待在有哈巴赫的身边"
  },
  {
    "index": "19",
    "time": "00:00:27,066 --> 00:00:28,566",
    "text": "目的是为了将其杀死"
  },
  {
    "index": "20",
    "time": "00:00:28,566 --> 00:00:30,533",
    "text": "由于有哈巴赫陷入沉睡时"
  },
  {
    "index": "21",
    "time": "00:00:30,533 --> 00:00:31,900",
    "text": "哈斯沃德会代替职长"
  },
  {
    "index": "22",
    "time": "00:00:31,900 --> 00:00:33,133",
    "text": "他全职全能的权补"
  },
  {
    "index": "23",
    "time": "00:00:33,133 --> 00:00:35,466",
    "text": "那么现在正是杀死他的最好时机"
  },
  {
    "index": "24",
    "time": "00:00:35,466 --> 00:00:37,133",
    "text": "石田让一户去对付有哈巴河"
  },
  {
    "index": "25",
    "time": "00:00:37,133 --> 00:00:38,766",
    "text": "他则在这里拦住哈斯沃人"
  },
  {
    "index": "26",
    "time": "00:00:38,766 --> 00:00:41,266",
    "text": "而面对也拥有全知全能的哈斯沃人"
  },
  {
    "index": "27",
    "time": "00:00:41,266 --> 00:00:42,700",
    "text": "石田即便开启完圣体"
  },
  {
    "index": "28",
    "time": "00:00:42,700 --> 00:00:43,966",
    "text": "也无法伤到气增好"
  },
  {
    "index": "29",
    "time": "00:00:43,966 --> 00:00:46,333",
    "text": "所有攻击在命中前就被全部夺走"
  },
  {
    "index": "30",
    "time": "00:00:46,333 --> 00:00:47,800",
    "text": "仿佛猫蟹老鼠一般"
  },
  {
    "index": "31",
    "time": "00:00:47,800 --> 00:00:49,766",
    "text": "石田根本就不是哈斯沃德的对手"
  },
  {
    "index": "32",
    "time": "00:00:49,766 --> 00:00:50,500",
    "text": "另一边"
  },
  {
    "index": "33",
    "time": "00:00:50,500 --> 00:00:52,733",
    "text": "四丰苑两姐弟在对战亚斯金时"
  },
  {
    "index": "34",
    "time": "00:00:52,733 --> 00:00:54,100",
    "text": "虽然初期占据优势"
  },
  {
    "index": "35",
    "time": "00:00:54,100 --> 00:00:55,500",
    "text": "但很快就被对方适应"
  },
  {
    "index": "36",
    "time": "00:00:55,500 --> 00:00:56,066",
    "text": "亚斯金"
  },
  {
    "index": "37",
    "time": "00:00:56,066 --> 00:00:57,866",
    "text": "可以通过大量摄取指定的物质"
  },
  {
    "index": "38",
    "time": "00:00:57,866 --> 00:00:58,900",
    "text": "操纵其质死"
  },
  {
    "index": "39",
    "time": "00:00:58,900 --> 00:01:01,166",
    "text": "因为两人疯狂将0押击入他体内"
  },
  {
    "index": "40",
    "time": "00:01:01,166 --> 00:01:03,266",
    "text": "如今凭借这BUG般的规则系能力"
  },
  {
    "index": "41",
    "time": "00:01:03,266 --> 00:01:03,800",
    "text": "亚金斯"
  },
  {
    "index": "42",
    "time": "00:01:03,800 --> 00:01:05,933",
    "text": "已经免疫了四丰苑两姐弟的攻击"
  },
  {
    "index": "43",
    "time": "00:01:05,933 --> 00:01:08,000",
    "text": "看着倒在血泊中即将死去的地狱"
  },
  {
    "index": "44",
    "time": "00:01:08,000 --> 00:01:09,100",
    "text": "叶伊也有心无力"
  },
  {
    "index": "45",
    "time": "00:01:09,100 --> 00:01:10,666",
    "text": "由于亚斯金将混合磷子"
  },
  {
    "index": "46",
    "time": "00:01:10,666 --> 00:01:12,966",
    "text": "氧气和氮气的足球打入到他的体内"
  },
  {
    "index": "47",
    "time": "00:01:12,966 --> 00:01:15,200",
    "text": "叶一现在几乎完全丧失了战斗能力"
  },
  {
    "index": "48",
    "time": "00:01:15,200 --> 00:01:16,200",
    "text": "趁你并要努力"
  },
  {
    "index": "49",
    "time": "00:01:16,200 --> 00:01:18,166",
    "text": "就在亚斯金准备将他杀死时"
  },
  {
    "index": "50",
    "time": "00:01:18,166 --> 00:01:19,300",
    "text": "店长突然出现"
  },
  {
    "index": "51",
    "time": "00:01:19,300 --> 00:01:20,866",
    "text": "然后随着他那么轻轻一摸"
  },
  {
    "index": "52",
    "time": "00:01:20,866 --> 00:01:22,300",
    "text": "刚刚还无法动弹的叶一"
  },
  {
    "index": "53",
    "time": "00:01:22,300 --> 00:01:23,266",
    "text": "直接飞天溜了"
  },
  {
    "index": "54",
    "time": "00:01:23,266 --> 00:01:24,800",
    "text": "亚斯金差点眼球瞪爆"
  },
  {
    "index": "55",
    "time": "00:01:24,800 --> 00:01:26,166",
    "text": "煮熟的鸭子都能飞掉"
  },
  {
    "index": "56",
    "time": "00:01:26,166 --> 00:01:27,100",
    "text": "他不由苦笑"
  },
  {
    "index": "57",
    "time": "00:01:27,100 --> 00:01:28,500",
    "text": "只能说这位不愧是陛下"
  },
  {
    "index": "58",
    "time": "00:01:28,500 --> 00:01:30,200",
    "text": "轻点的5大特级战力之一"
  },
  {
    "index": "59",
    "time": "00:01:30,200 --> 00:01:32,600",
    "text": "黑棋一护的潜能跟穆建巴的战斗力"
  },
  {
    "index": "60",
    "time": "00:01:32,600 --> 00:01:34,066",
    "text": "兵主部一兵位的睿智"
  },
  {
    "index": "61",
    "time": "00:01:34,066 --> 00:01:35,400",
    "text": "蓝然总右界的灵压"
  },
  {
    "index": "62",
    "time": "00:01:35,400 --> 00:01:37,266",
    "text": "以及普援洗柱的位置手段"
  },
  {
    "index": "63",
    "time": "00:01:37,266 --> 00:01:38,900",
    "text": "原来店长在偷听两人对话时"
  },
  {
    "index": "64",
    "time": "00:01:38,900 --> 00:01:40,166",
    "text": "就做出了免疫强化境"
  },
  {
    "index": "65",
    "time": "00:01:40,166 --> 00:01:41,966",
    "text": "然后将其注入到了叶一体内"
  },
  {
    "index": "66",
    "time": "00:01:41,966 --> 00:01:43,566",
    "text": "不过因为是赶工的粗糙品"
  },
  {
    "index": "67",
    "time": "00:01:43,566 --> 00:01:45,333",
    "text": "免疫剂的效果只有5分钟"
  },
  {
    "index": "68",
    "time": "00:01:45,333 --> 00:01:46,700",
    "text": "叶一本想在这5分钟内"
  },
  {
    "index": "69",
    "time": "00:01:46,700 --> 00:01:48,266",
    "text": "通过雷神战刑解决战斗"
  },
  {
    "index": "70",
    "time": "00:01:48,266 --> 00:01:50,200",
    "text": "不过店长却让他用另一种形态"
  },
  {
    "index": "71",
    "time": "00:01:50,200 --> 00:01:51,500",
    "text": "叶一听后果断拒绝"
  },
  {
    "index": "72",
    "time": "00:01:51,500 --> 00:01:51,933",
    "text": "一想到"
  },
  {
    "index": "73",
    "time": "00:01:51,933 --> 00:01:53,666",
    "text": "自己会变成那种半吊子的恶心"
  },
  {
    "index": "74",
    "time": "00:01:53,900 --> 00:01:54,866",
    "text": "他就一阵反感"
  },
  {
    "index": "75",
    "time": "00:01:54,866 --> 00:01:56,933",
    "text": "突然一道紫光划破天际"
  },
  {
    "index": "76",
    "time": "00:01:56,933 --> 00:01:58,200",
    "text": "使亚斯金追了过来"
  },
  {
    "index": "77",
    "time": "00:01:58,200 --> 00:01:59,933",
    "text": "叶一见状立刻朝其冲去"
  },
  {
    "index": "78",
    "time": "00:01:59,933 --> 00:02:01,333",
    "text": "然而正如之前所说"
  },
  {
    "index": "79",
    "time": "00:02:01,333 --> 00:02:02,933",
    "text": "亚斯金已经完全免疫了叶"
  },
  {
    "index": "80",
    "time": "00:02:02,933 --> 00:02:04,400",
    "text": "一雷神形态下的攻击"
  },
  {
    "index": "81",
    "time": "00:02:04,400 --> 00:02:05,266",
    "text": "仅仅几招"
  },
  {
    "index": "82",
    "time": "00:02:05,266 --> 00:02:06,500",
    "text": "叶一就被再次打倒"
  },
  {
    "index": "83",
    "time": "00:02:06,500 --> 00:02:07,533",
    "text": "而就在这时"
  },
  {
    "index": "84",
    "time": "00:02:07,533 --> 00:02:09,100",
    "text": "店长渐渐的声音传染"
  },
  {
    "index": "85",
    "time": "00:02:09,100 --> 00:02:10,000",
    "text": "亚斯金不明白"
  },
  {
    "index": "86",
    "time": "00:02:10,000 --> 00:02:11,900",
    "text": "自己明明已经免疫了对方的灵压"
  },
  {
    "index": "87",
    "time": "00:02:11,900 --> 00:02:13,633",
    "text": "可为什么现在会被差点打死"
  },
  {
    "index": "88",
    "time": "00:02:13,633 --> 00:02:15,700",
    "text": "黑猫战机形态下的夜一灵压"
  },
  {
    "index": "89",
    "time": "00:02:15,700 --> 00:02:16,833",
    "text": "会随着心情变化"
  },
  {
    "index": "90",
    "time": "00:02:16,833 --> 00:02:17,200",
    "text": "虽然"
  },
  {
    "index": "91",
    "time": "00:02:17,200 --> 00:02:19,266",
    "text": "亚斯金的致死量能力可以快速适应"
  },
  {
    "index": "92",
    "time": "00:02:19,266 --> 00:02:20,500",
    "text": "并免疫对手攻击"
  },
  {
    "index": "93",
    "time": "00:02:20,500 --> 00:02:21,700",
    "text": "然而现在的夜一"
  },
  {
    "index": "94",
    "time": "00:02:21,700 --> 00:02:23,666",
    "text": "灵压一秒钟会变化48次"
  },
  {
    "index": "95",
    "time": "00:02:23,666 --> 00:02:24,633",
    "text": "他根本赶不上"
  },
  {
    "index": "96",
    "time": "00:02:24,633 --> 00:02:26,900",
    "text": "即便摩叙罗来了也只能说句牛逼"
  },
  {
    "index": "97",
    "time": "00:02:26,900 --> 00:02:27,833",
    "text": "看这副模样"
  },
  {
    "index": "98",
    "time": "00:02:27,833 --> 00:02:29,633",
    "text": "知道叶一当时为什么会拒绝"
  },
  {
    "index": "99",
    "time": "00:02:29,700 --> 00:02:31,233",
    "text": "随着5分钟实现到达"
  },
  {
    "index": "100",
    "time": "00:02:31,233 --> 00:02:32,166",
    "text": "免疫剂失效"
  },
  {
    "index": "101",
    "time": "00:02:32,166 --> 00:02:33,300",
    "text": "店长放下叶一"
  },
  {
    "index": "102",
    "time": "00:02:33,300 --> 00:02:34,833",
    "text": "准备去找到亚斯金的尸体"
  },
  {
    "index": "103",
    "time": "00:02:34,833 --> 00:02:35,866",
    "text": "给予最后一击"
  },
  {
    "index": "104",
    "time": "00:02:35,866 --> 00:02:37,633",
    "text": "然而就在这时一扁屠手"
  },
  {
    "index": "105",
    "time": "00:02:37,833 --> 00:02:39,733",
    "text": "好了以上便是本集的所有内容了"
  },
  {
    "index": "106",
    "time": "00:02:39,733 --> 00:02:41,433",
    "text": "从片尾的异地也可以看出"
  },
  {
    "index": "107",
    "time": "00:02:41,433 --> 00:02:43,200",
    "text": "这一次死神是真的要完结了"
  },
  {
    "index": "108",
    "time": "00:02:43,200 --> 00:02:44,633",
    "text": "千年血战偏祸竟弹"
  },
  {
    "index": "109",
    "time": "00:02:44,633 --> 00:02:46,333",
    "text": "剧情紧接向课坛讲述"
  },
  {
    "index": "110",
    "time": "00:02:46,333 --> 00:02:48,166",
    "text": "有哈巴赫攻入灵王宫一户"
  },
  {
    "index": "111",
    "time": "00:02:48,166 --> 00:02:50,533",
    "text": "在其轨迹下斩杀灵王导致三界崩塌"
  },
  {
    "index": "112",
    "time": "00:02:50,533 --> 00:02:51,866",
    "text": "残存势力予以超越"
  },
  {
    "index": "113",
    "time": "00:02:51,866 --> 00:02:54,400",
    "text": "全知全能的有哈巴赫展开最终决战"
  },
  {
    "index": "114",
    "time": "00:02:54,400 --> 00:02:56,433",
    "text": "原作漫画因赶工导致结局草草"
  },
  {
    "index": "115",
    "time": "00:02:56,433 --> 00:02:58,533",
    "text": "而动漫版因久保代人深度参与"
  },
  {
    "index": "116",
    "time": "00:02:58,533 --> 00:02:59,433",
    "text": "扩充原创内容"
  },
  {
    "index": "117",
    "time": "00:02:59,433 --> 00:03:00,133",
    "text": "备受好评"
  },
  {
    "index": "118",
    "time": "00:03:00,133 --> 00:03:00,600",
    "text": "当然"
  },
  {
    "index": "119",
    "time": "00:03:00,600 --> 00:03:02,800",
    "text": "能否妥善处理原作后期战力崩坏"
  },
  {
    "index": "120",
    "time": "00:03:02,800 --> 00:03:04,333",
    "text": "而为克制而克制的争议"
  },
  {
    "index": "121",
    "time": "00:03:04,333 --> 00:03:05,933",
    "text": "是其面临的最大挑战"
  },
  {
    "index": "122",
    "time": "00:03:05,933 --> 00:03:07,600",
    "text": "霍静谭不仅是动漫的终结"
  },
  {
    "index": "123",
    "time": "00:03:07,600 --> 00:03:09,066",
    "text": "更是死神这个经典IP"
  },
  {
    "index": "124",
    "time": "00:03:09,066 --> 00:03:10,666",
    "text": "一次至关重要的自我证明"
  },
  {
    "index": "125",
    "time": "00:03:10,666 --> 00:03:12,000",
    "text": "他承载着弥补漫画遗憾"
  },
  {
    "index": "126",
    "time": "00:03:12,000 --> 00:03:13,666",
    "text": "回馈粉丝多年等待的重点"
  },
  {
    "index": "127",
    "time": "00:03:13,666 --> 00:03:15,533",
    "text": "这部承载了太多期待的最终章"
  },
  {
    "index": "128",
    "time": "00:03:15,533 --> 00:03:16,566",
    "text": "能否完美收官"
  },
  {
    "index": "129",
    "time": "00:03:16,566 --> 00:03:17,800",
    "text": "值得我们共同见证"
  }
]