[
  {
    "index": "1",
    "time": "00:00:00,133 --> 00:00:01,533",
    "text": "男人转动手上的光圈"
  },
  {
    "index": "2",
    "time": "00:00:01,533 --> 00:00:03,400",
    "text": "紧接着光圈化作巨大的毒魂"
  },
  {
    "index": "3",
    "time": "00:00:03,400 --> 00:00:04,533",
    "text": "随着他向前一甩"
  },
  {
    "index": "4",
    "time": "00:00:04,533 --> 00:00:05,700",
    "text": "毒环突然消失"
  },
  {
    "index": "5",
    "time": "00:00:05,700 --> 00:00:07,300",
    "text": "下一刻那压缩到极致的剧毒"
  },
  {
    "index": "6",
    "time": "00:00:07,300 --> 00:00:08,733",
    "text": "竟然在店长眼球上展开"
  },
  {
    "index": "7",
    "time": "00:00:08,733 --> 00:00:09,966",
    "text": "而这刚刚展现的力量"
  },
  {
    "index": "8",
    "time": "00:00:09,966 --> 00:00:11,800",
    "text": "只是男人真正实力的冰山一角"
  },
  {
    "index": "9",
    "time": "00:00:11,800 --> 00:00:13,300",
    "text": "就在所有人都以为这一战"
  },
  {
    "index": "10",
    "time": "00:00:13,300 --> 00:00:14,166",
    "text": "必败无疑时"
  },
  {
    "index": "11",
    "time": "00:00:14,166 --> 00:00:16,066",
    "text": "店长的嘴角却突然扬起"
  },
  {
    "index": "12",
    "time": "00:00:16,433 --> 00:00:18,533",
    "text": "万总观音开红机管对战完胜"
  },
  {
    "index": "13",
    "time": "00:00:18,533 --> 00:00:19,400",
    "text": "死神之不见"
  },
  {
    "index": "14",
    "time": "00:00:19,400 --> 00:00:21,533",
    "text": "千年血战篇最终暨第二战开始"
  },
  {
    "index": "15",
    "time": "00:00:21,533 --> 00:00:21,966",
    "text": "本以为"
  },
  {
    "index": "16",
    "time": "00:00:21,966 --> 00:00:24,033",
    "text": "开启顺龙黑猫战机形态下的夜一"
  },
  {
    "index": "17",
    "time": "00:00:24,033 --> 00:00:25,400",
    "text": "已经将亚斯金杀死"
  },
  {
    "index": "18",
    "time": "00:00:25,400 --> 00:00:27,400",
    "text": "就在他彻底失去战斗力之时"
  },
  {
    "index": "19",
    "time": "00:00:27,400 --> 00:00:28,233",
    "text": "易变突升"
  },
  {
    "index": "20",
    "time": "00:00:28,233 --> 00:00:29,500",
    "text": "巨大的紫黑色光球"
  },
  {
    "index": "21",
    "time": "00:00:29,500 --> 00:00:31,500",
    "text": "将整片区域全部笼罩其中"
  },
  {
    "index": "22",
    "time": "00:00:31,500 --> 00:00:32,933",
    "text": "紧接着亚斯金完好无损"
  },
  {
    "index": "23",
    "time": "00:00:32,933 --> 00:00:34,200",
    "text": "从上方缓缓降落"
  },
  {
    "index": "24",
    "time": "00:00:34,200 --> 00:00:35,300",
    "text": "他如今的姿态"
  },
  {
    "index": "25",
    "time": "00:00:35,300 --> 00:00:37,200",
    "text": "只要敌人自身零压的本质相同"
  },
  {
    "index": "26",
    "time": "00:00:37,200 --> 00:00:39,033",
    "text": "无论如何变化都能瞬间免疫"
  },
  {
    "index": "27",
    "time": "00:00:39,033 --> 00:00:40,100",
    "text": "并将其无效法"
  },
  {
    "index": "28",
    "time": "00:00:40,100 --> 00:00:40,700",
    "text": "也就是说"
  },
  {
    "index": "29",
    "time": "00:00:40,700 --> 00:00:43,033",
    "text": "店长和叶一的手段彻底对他不管用"
  },
  {
    "index": "30",
    "time": "00:00:43,100 --> 00:00:44,233",
    "text": "同时为了以防万一"
  },
  {
    "index": "31",
    "time": "00:00:44,233 --> 00:00:46,200",
    "text": "亚斯金将这片蒙古领域封死"
  },
  {
    "index": "32",
    "time": "00:00:46,200 --> 00:00:48,233",
    "text": "直接断绝了两人逃离的所有可能"
  },
  {
    "index": "33",
    "time": "00:00:48,233 --> 00:00:48,933",
    "text": "既然逃不掉"
  },
  {
    "index": "34",
    "time": "00:00:48,933 --> 00:00:49,733",
    "text": "那就只能战"
  },
  {
    "index": "35",
    "time": "00:00:49,733 --> 00:00:51,633",
    "text": "一刀推出虽然快到离谱"
  },
  {
    "index": "36",
    "time": "00:00:51,633 --> 00:00:53,366",
    "text": "可依旧被亚斯金反应过来"
  },
  {
    "index": "37",
    "time": "00:00:53,366 --> 00:00:55,233",
    "text": "而即便是在如今看似必胜的米"
  },
  {
    "index": "38",
    "time": "00:00:55,233 --> 00:00:55,933",
    "text": "亚局视线"
  },
  {
    "index": "39",
    "time": "00:00:55,933 --> 00:00:57,800",
    "text": "对于眼前这个危险至极的男人"
  },
  {
    "index": "40",
    "time": "00:00:57,800 --> 00:00:59,500",
    "text": "亚斯金依旧没有丝毫大意"
  },
  {
    "index": "41",
    "time": "00:00:59,500 --> 00:01:00,933",
    "text": "他直接射出蒙毒戒指"
  },
  {
    "index": "42",
    "time": "00:01:00,933 --> 00:01:02,800",
    "text": "将致死量的能力集中于一股"
  },
  {
    "index": "43",
    "time": "00:01:02,800 --> 00:01:04,300",
    "text": "在店长的眼球上炸开"
  },
  {
    "index": "44",
    "time": "00:01:04,300 --> 00:01:05,700",
    "text": "并发动急死效果"
  },
  {
    "index": "45",
    "time": "00:01:05,700 --> 00:01:06,500",
    "text": "而接下来"
  },
  {
    "index": "46",
    "time": "00:01:06,500 --> 00:01:07,600",
    "text": "店长的五脏六腑"
  },
  {
    "index": "47",
    "time": "00:01:07,600 --> 00:01:09,033",
    "text": "会随着急死效果蔓延"
  },
  {
    "index": "48",
    "time": "00:01:09,033 --> 00:01:10,000",
    "text": "全部被摧毁"
  },
  {
    "index": "49",
    "time": "00:01:10,000 --> 00:01:10,966",
    "text": "就在亚斯金以为"
  },
  {
    "index": "50",
    "time": "00:01:10,966 --> 00:01:12,900",
    "text": "这场战斗终于可以结束之时"
  },
  {
    "index": "51",
    "time": "00:01:12,900 --> 00:01:14,700",
    "text": "洪基奈因到梅边的万姐出现了"
  },
  {
    "index": "52",
    "time": "00:01:14,700 --> 00:01:16,633",
    "text": "再有哈巴赫给了所有情报根"
  },
  {
    "index": "53",
    "time": "00:01:16,633 --> 00:01:18,700",
    "text": "本没有捕援喜助万姐的任何消息"
  },
  {
    "index": "54",
    "time": "00:01:18,700 --> 00:01:20,900",
    "text": "毕竟和蓝染对战之时店长都没使过"
  },
  {
    "index": "55",
    "time": "00:01:20,900 --> 00:01:22,833",
    "text": "亚斯金没想到居然让自己碰到了"
  },
  {
    "index": "56",
    "time": "00:01:22,833 --> 00:01:24,533",
    "text": "突然他感觉身体有些不对劲"
  },
  {
    "index": "57",
    "time": "00:01:24,533 --> 00:01:25,333",
    "text": "低头一看"
  },
  {
    "index": "58",
    "time": "00:01:25,333 --> 00:01:27,333",
    "text": "手臂上的肌肉居然全部崩裂"
  },
  {
    "index": "59",
    "time": "00:01:27,333 --> 00:01:28,133",
    "text": "仅一瞬间"
  },
  {
    "index": "60",
    "time": "00:01:28,133 --> 00:01:28,500",
    "text": "亚斯"
  },
  {
    "index": "61",
    "time": "00:01:28,500 --> 00:01:30,733",
    "text": "金就和店长的距离拉开到800米之外"
  },
  {
    "index": "62",
    "time": "00:01:30,733 --> 00:01:32,900",
    "text": "虽然凭借完圣体的能力超速再生"
  },
  {
    "index": "63",
    "time": "00:01:32,900 --> 00:01:34,500",
    "text": "但他还是惊出了一身冷汗"
  },
  {
    "index": "64",
    "time": "00:01:34,500 --> 00:01:36,366",
    "text": "而这便是观音开洪基改的能力"
  },
  {
    "index": "65",
    "time": "00:01:36,366 --> 00:01:38,300",
    "text": "将接触到的事物重新改造"
  },
  {
    "index": "66",
    "time": "00:01:38,300 --> 00:01:39,933",
    "text": "挪前方烟尘散去"
  },
  {
    "index": "67",
    "time": "00:01:39,933 --> 00:01:41,233",
    "text": "亚斯金恼怒至极"
  },
  {
    "index": "68",
    "time": "00:01:41,233 --> 00:01:43,600",
    "text": "他本想用最稳妥的方式将对方杀死"
  },
  {
    "index": "69",
    "time": "00:01:43,600 --> 00:01:45,433",
    "text": "可现在又被逼的不得不进行力量"
  },
  {
    "index": "70",
    "time": "00:01:45,433 --> 00:01:46,700",
    "text": "和力量上的正面对决"
  },
  {
    "index": "71",
    "time": "00:01:46,700 --> 00:01:47,133",
    "text": "只能说"
  },
  {
    "index": "72",
    "time": "00:01:47,133 --> 00:01:49,200",
    "text": "这个男人不愧是五大特级战略之一"
  },
  {
    "index": "73",
    "time": "00:01:49,200 --> 00:01:50,266",
    "text": "不过亚斯金自信"
  },
  {
    "index": "74",
    "time": "00:01:50,266 --> 00:01:51,666",
    "text": "没有人能做到完美无趣"
  },
  {
    "index": "75",
    "time": "00:01:51,666 --> 00:01:53,833",
    "text": "这个极致足球是绝对无法逃脱"
  },
  {
    "index": "76",
    "time": "00:01:53,833 --> 00:01:54,466",
    "text": "无知要散"
  },
  {
    "index": "77",
    "time": "00:01:54,466 --> 00:01:56,533",
    "text": "对方现在之所以还能在这里呼吸"
  },
  {
    "index": "78",
    "time": "00:01:56,533 --> 00:01:58,100",
    "text": "是自己还在控制毒的能力"
  },
  {
    "index": "79",
    "time": "00:01:58,100 --> 00:02:00,166",
    "text": "那么接下来他就要将其彻底一点"
  },
  {
    "index": "80",
    "time": "00:02:00,266 --> 00:02:01,633",
    "text": "蜀之不尽的紫黑色足球"
  },
  {
    "index": "81",
    "time": "00:02:01,633 --> 00:02:02,666",
    "text": "朝着天际射举"
  },
  {
    "index": "82",
    "time": "00:02:02,666 --> 00:02:04,100",
    "text": "而这仅仅只是开始"
  },
  {
    "index": "83",
    "time": "00:02:04,100 --> 00:02:05,833",
    "text": "那巨大到难以想象的毒酒"
  },
  {
    "index": "84",
    "time": "00:02:05,833 --> 00:02:07,800",
    "text": "以及丛中分裂出的小型毒酒"
  },
  {
    "index": "85",
    "time": "00:02:07,800 --> 00:02:08,433",
    "text": "即便躲过"
  },
  {
    "index": "86",
    "time": "00:02:08,433 --> 00:02:10,766",
    "text": "也无时无刻不再散发出致命的气体"
  },
  {
    "index": "87",
    "time": "00:02:10,800 --> 00:02:12,566",
    "text": "店长不可能做到不去呼吸"
  },
  {
    "index": "88",
    "time": "00:02:12,600 --> 00:02:14,466",
    "text": "所以得通过能力一直修复自身"
  },
  {
    "index": "89",
    "time": "00:02:14,466 --> 00:02:14,666",
    "text": "但"
  },
  {
    "index": "90",
    "time": "00:02:14,666 --> 00:02:16,833",
    "text": "这也给予了亚斯金攻击的可乘之机"
  },
  {
    "index": "91",
    "time": "00:02:16,833 --> 00:02:18,500",
    "text": "随着剧毒浓度的不断提升"
  },
  {
    "index": "92",
    "time": "00:02:18,500 --> 00:02:19,666",
    "text": "如今即便是店长"
  },
  {
    "index": "93",
    "time": "00:02:19,666 --> 00:02:21,200",
    "text": "也只能勉强在地上爬行"
  },
  {
    "index": "94",
    "time": "00:02:21,200 --> 00:02:22,900",
    "text": "不过亚斯金还是没有松懈"
  },
  {
    "index": "95",
    "time": "00:02:23,033 --> 00:02:24,900",
    "text": "虽然说极之足球无法逃出去"
  },
  {
    "index": "96",
    "time": "00:02:24,900 --> 00:02:26,966",
    "text": "可对方却没说无法从外面进攻"
  },
  {
    "index": "97",
    "time": "00:02:26,966 --> 00:02:28,266",
    "text": "所以店长早在之前"
  },
  {
    "index": "98",
    "time": "00:02:28,266 --> 00:02:29,233",
    "text": "就从球体外部"
  },
  {
    "index": "99",
    "time": "00:02:29,233 --> 00:02:30,833",
    "text": "创造了一条进入里面的道路"
  },
  {
    "index": "100",
    "time": "00:02:30,833 --> 00:02:31,633",
    "text": "在战斗前"
  },
  {
    "index": "101",
    "time": "00:02:31,633 --> 00:02:33,333",
    "text": "店长只要觉得会派上用场"
  },
  {
    "index": "102",
    "time": "00:02:33,333 --> 00:02:35,433",
    "text": "哪怕是有一千种手段他都会去布置"
  },
  {
    "index": "103",
    "time": "00:02:35,433 --> 00:02:37,366",
    "text": "这就是普元洗烛最恐怖的敌人"
  },
  {
    "index": "104",
    "time": "00:02:37,366 --> 00:02:39,166",
    "text": "另一边葛利姆乔没有废话"
  },
  {
    "index": "105",
    "time": "00:02:39,166 --> 00:02:40,833",
    "text": "再次给了亚斯金致命一击"
  },
  {
    "index": "106",
    "time": "00:02:40,833 --> 00:02:42,533",
    "text": "而就在他转身准备离去时"
  },
  {
    "index": "107",
    "time": "00:02:42,533 --> 00:02:44,066",
    "text": "身体却突然失去了控制"
  },
  {
    "index": "108",
    "time": "00:02:44,066 --> 00:02:45,666",
    "text": "原来亚斯金在死亡时"
  },
  {
    "index": "109",
    "time": "00:02:45,666 --> 00:02:47,866",
    "text": "极之足球的限制将会被全部解除"
  },
  {
    "index": "110",
    "time": "00:02:47,866 --> 00:02:48,466",
    "text": "而接下来"
  },
  {
    "index": "111",
    "time": "00:02:48,466 --> 00:02:50,466",
    "text": "在这个领域内的所有人都会死"
  },
  {
    "index": "112",
    "time": "00:02:50,466 --> 00:02:52,300",
    "text": "好了以上便是本集的所有内容"
  },
  {
    "index": "113",
    "time": "00:02:52,300 --> 00:02:54,366",
    "text": "洪基作为解放语最多的斩获道"
  },
  {
    "index": "114",
    "time": "00:02:54,366 --> 00:02:56,500",
    "text": "即便只是使解的攻击力也高的可怕"
  },
  {
    "index": "115",
    "time": "00:02:56,500 --> 00:02:58,766",
    "text": "而直到死神千年血战篇最终结"
  },
  {
    "index": "116",
    "time": "00:02:58,766 --> 00:03:00,066",
    "text": "我们才看到他的乱境"
  },
  {
    "index": "117",
    "time": "00:03:00,066 --> 00:03:00,500",
    "text": "不知道"
  },
  {
    "index": "118",
    "time": "00:03:00,500 --> 00:03:02,633",
    "text": "对于这8个集的规则性能力呈现"
  },
  {
    "index": "119",
    "time": "00:03:02,633 --> 00:03:03,833",
    "text": "是否让大家满意了"
  },
  {
    "index": "120",
    "time": "00:03:03,833 --> 00:03:05,233",
    "text": "比亚斯金的这场战斗"
  },
  {
    "index": "121",
    "time": "00:03:05,233 --> 00:03:07,366",
    "text": "是店长多算胜性格的极致体现"
  },
  {
    "index": "122",
    "time": "00:03:07,366 --> 00:03:08,566",
    "text": "甚至他本人被有哈"
  },
  {
    "index": "123",
    "time": "00:03:08,566 --> 00:03:10,266",
    "text": "巴赫列为5大特技战役之一"
  },
  {
    "index": "124",
    "time": "00:03:10,266 --> 00:03:11,766",
    "text": "也是因为其未知的手段"
  },
  {
    "index": "125",
    "time": "00:03:11,766 --> 00:03:13,433",
    "text": "在既定的规则致死量下"
  },
  {
    "index": "126",
    "time": "00:03:13,433 --> 00:03:15,866",
    "text": "用情报道具和陷阱开出的最优点"
  },
  {
    "index": "127",
    "time": "00:03:15,866 --> 00:03:17,733",
    "text": "他证明了椭圆的强大不在于力量"
  },
  {
    "index": "128",
    "time": "00:03:17,733 --> 00:03:19,366",
    "text": "能量而在于他能用智慧"
  },
  {
    "index": "129",
    "time": "00:03:19,366 --> 00:03:21,300",
    "text": "将绝境改写为可计算的本事"
  },
  {
    "index": "130",
    "time": "00:03:21,300 --> 00:03:23,333",
    "text": "上周千年血战篇霍靖谭第一集"
  },
  {
    "index": "131",
    "time": "00:03:23,333 --> 00:03:24,300",
    "text": "在国外IMDB"
  },
  {
    "index": "132",
    "time": "00:03:24,300 --> 00:03:26,333",
    "text": "评分榜上拿下9.7的逆天高坟"
  },
  {
    "index": "133",
    "time": "00:03:26,333 --> 00:03:28,566",
    "text": "那满屏的经费实在是让人叹为观止"
  },
  {
    "index": "134",
    "time": "00:03:28,566 --> 00:03:31,100",
    "text": "而这对应这一整集高潮才刚刚开始"
  },
  {
    "index": "135",
    "time": "00:03:31,100 --> 00:03:33,066",
    "text": "就让我们继续期待后续的内容吧"
  }
]